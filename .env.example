# Copy this file to ".env" and fill in the two values from your Supabase
# project: Project Settings -> API Keys (and the project URL on the same page).
# Both are safe to ship inside the app; the database rules protect the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key

# Optional: the public address of the site, used for the join link and QR
# code. On Vercel this is filled in automatically.
# EXPO_PUBLIC_APP_URL=https://your-site.example.com
